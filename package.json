{
  "name": "react-express-supabase-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev -w @app/web\" \"npm run dev -w @app/api\"",
    "dev:web": "npm run dev -w @app/web",
    "dev:api": "npm run dev -w @app/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @app/api",
    "db:migrate": "npm run db:migrate -w @app/api",
    "db:seed": "npm run db:seed -w @app/api",
    "db:studio": "npm run db:studio -w @app/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
