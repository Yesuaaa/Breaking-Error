generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  // Uses the same UUID as the user in Supabase Auth.
  id               String             @id @db.Uuid
  email            String             @unique
  name             String?
  accountRole      AccountRole        @default(USER) @map("account_role")
  memberships      Membership[]
  messages         Message[]
  tasksCreated     Task[]             @relation("TaskCreator")
  materialsCreated LearningMaterial[] @relation("MaterialCreator")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("profiles")
}

model Subject {
  id          String             @id @default(uuid()) @db.Uuid
  code        String
  name        String
  section     String
  term        String
  memberships Membership[]
  messages    Message[]
  tasks       Task[]
  materials   LearningMaterial[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([code, section, term])
  @@map("subjects")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  role      MembershipRole
  profileId String         @map("profile_id") @db.Uuid
  subjectId String         @map("subject_id") @db.Uuid
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([profileId, subjectId])
  @@index([subjectId])
  @@map("memberships")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  content   String   @db.VarChar(4000)
  authorId  String   @map("author_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([subjectId, createdAt])
  @@map("messages")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(200)
  description String?   @db.VarChar(4000)
  dueAt       DateTime? @map("due_at")
  points      Int?
  subjectId   String    @map("subject_id") @db.Uuid
  creatorId   String    @map("creator_id") @db.Uuid
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  creator     Profile   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([subjectId, dueAt])
  @@map("tasks")
}

model LearningMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(4000)
  url         String   @db.VarChar(2048)
  subjectId   String   @map("subject_id") @db.Uuid
  creatorId   String   @map("creator_id") @db.Uuid
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  creator     Profile  @relation("MaterialCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([subjectId, createdAt])
  @@map("learning_materials")
}

enum MembershipRole {
  STUDENT
  PROFESSOR
}

enum AccountRole {
  USER
  ADMIN
}
