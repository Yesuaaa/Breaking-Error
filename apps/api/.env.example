NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Supabase transaction pooler URL (port 6543, append ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct database URL used by Prisma migrations (port 5432)
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
# Keep this server-only. Never expose it through a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional demo credentials used by `npm run db:seed`.
SEED_PROFESSOR_EMAIL=professor@example.edu
SEED_PROFESSOR_PASSWORD=Professor123!
SEED_STUDENT_PASSWORD=Student123!
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=Admin123!
